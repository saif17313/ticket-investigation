# QueueStorm Investigator — environment template
# Copy to .env and fill in real values. Never commit .env.

# Google Gemini API key (optional at startup; required only if LLM_ENABLED=true)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Runtime
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=8.0
HIGH_VALUE_THRESHOLD=10000
LOG_LEVEL=INFO
